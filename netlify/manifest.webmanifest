{
  "name": "Chess Career — become a chess pro",
  "short_name": "Chess Career",
  "description": "Live the life of a chess professional: climb the ratings, earn titles, prepare openings, build rivalries, sign sponsors, stream, and spend your winnings — all offline once loaded.",
  "id": "./",
  "start_url": "./index.html",
  "scope": "./",
  "display": "standalone",
  "display_override": ["standalone", "minimal-ui"],
  "orientation": "any",
  "background_color": "#0b1120",
  "theme_color": "#0b1120",
  "categories": ["games", "education"],
  "share_target": {
    "action": "./share-target",
    "method": "POST",
    "enctype": "multipart/form-data",
    "params": {
      "title": "title",
      "text": "text",
      "files": [{ "name": "backup", "accept": ["application/json", ".json", "text/plain"] }]
    }
  },
  "icons": [
    { "src": "icon-192.png", "sizes": "192x192", "type": "image/png", "purpose": "any" },
    { "src": "icon-512.png", "sizes": "512x512", "type": "image/png", "purpose": "any" },
    { "src": "icon-512-maskable.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable" }
  ]
}
